# Copy to .env and fill in. `.env` is gitignored and is read by the `trainer`
# command only -- the test suite never loads it, because conftest.py takes
# credentials away from every test on purpose and a file that put them back
# would turn that guarantee into a guarantee about this machine.
#
# The defaults need OPENROUTER_API_KEY and, for `trainer bot`, the two Telegram
# lines; everything else is optional. A missing value is reported as a state
# with the way out rather than as a failure of the plan you asked for.

# Which provider the coach talks to: openrouter, groq or ollama. Defaults to
# openrouter, where each node runs the model, effort and host its matrix chose
# (docs/adr/0011). ollama runs on this machine and costs nothing. Any other
# value is refused by name rather than quietly falling through to a provider
# you did not ask for.
LLM_BACKEND=

# Each subgraph's own model, on the provider above, named the way that
# provider names it. Empty on OpenRouter is the node's measured choice
# (anthropic/claude-haiku-4.5 plans, deepseek/deepseek-v4-flash logs), or
# OPENROUTER_MODEL when that is set; elsewhere it is the provider's model
# (OLLAMA_MODEL or GROQ_MODEL). Both are checked before a run or the bot starts.
PLANNER_MODEL=
LOGGER_MODEL=

# -- Ollama --------------------------------------------------------------------

# The local model. Defaults to gpt-oss:20b, which has to be pulled before it
# can plan: `ollama pull gpt-oss:20b`. On the dev laptop it reads 52 tok/s and
# writes 10.3 tok/s, which is about four minutes for one plan and eleven when
# the validator refuses twice.
#
# Those are CPU numbers, and on that machine they are the only numbers there
# are: gpt-oss:20b terminates the Radeon 860M's Vulkan backend at any offload,
# four layers and 2.4 GB included, while llama3.1 runs on the same device. It
# is the model's MXFP4 quantisation against that driver, not memory. Set
# OLLAMA_IGPU_ENABLE=0 in the environment the Ollama *server* starts in, or
# every load fails with `llama-server process has terminated`. That variable
# belongs to Ollama and not to this file, which is why it is documented here
# and not set here.
OLLAMA_MODEL=

# How much of the model's context window to declare, in tokens. `trainer plan`
# falls back to the server's own setting; `trainer bot` refuses to start without
# at least 8192, the length session 6 measured at -- below it the admissible set
# is truncated and plans are refused for no visible reason. Measured: at 8192 a
# brief carrying half the catalog as stated preferences made the model emit a
# tool call its own server could not parse back. 16384 is what the dev laptop
# runs, and a 12 GB model plus a 16k context is at the edge of 32 GB in use.
OLLAMA_CONTEXT_LENGTH=

# Where the Ollama server is. Defaults to the local one on port 11434.
OLLAMA_BASE_URL=

# -- The entrance --------------------------------------------------------------

# The entrance is the part of the bot you talk to: it answers the turn and
# hands the planning and the logging to the graphs behind it (ADR-0006). It is
# the node latency is felt on -- a conversational hello on gpt-oss:20b costs
# half a minute on this laptop's CPU, which is worse than the silence it
# replaces -- so it runs on a model of its own.
#
# ENTRANCE_BACKEND is which provider it talks on and defaults to LLM_BACKEND's,
# so pointing the planner at Groq while the entrance stays local is two lines.
# ENTRANCE_MODEL defaults to openai/gpt-oss-120b at low effort on Cerebras on
# OpenRouter (0.3-1.2 s a turn), to llama3.1 on Ollama and to GROQ_MODEL's on
# Groq.
# `trainer bot` checks it is there before it starts, the same way it checks the
# planner's, and it never asks it to reason: Ollama refuses the setting with a
# 400 on a model that has no thinking phase, llama3.1 among them.
#
# Measured on the dev laptop: one turn on llama3.1 is about a minute, because
# ~2.7k of the input is the tool definitions and the CPU reads 52 tok/s. Saying
# one thing that happened, which binds no tools, is 6 seconds. If the chat feels
# slow, this is the line to change -- a 3B model, or ENTRANCE_BACKEND=groq.
ENTRANCE_BACKEND=
ENTRANCE_MODEL=

# -- Groq ----------------------------------------------------------------------

# Required when LLM_BACKEND=groq. https://console.groq.com/keys
GROQ_API_KEY=

# The Groq model. Defaults to qwen/qwen3.8-27b, whose structured output runs in
# *strict* mode -- constrained decoding, so the emitted document conforms to the
# schema by construction rather than by luck. Strict is not a preference:
# without it the enum of today's admissible ids is a suggestion, and an invented
# exercise id becomes possible again. A name Groq has retired -- qwen/qwen3.6-27b
# is one -- is reported before the run starts, with the list of what it serves.
# openai/gpt-oss-120b is strict as well; note that the gpt-oss models reason
# inside GROQ_MAX_TOKENS and need more of it than the free tier allows.
GROQ_MODEL=

# How much the model may write in one turn, reasoning included. Defaults to
# 1000, which is the free tier's ceiling on output tokens per minute -- declare
# more than the tier allows and the request is refused before any of it runs.
# Raise it on a paid tier: it is the first number to reach for when a plan
# comes back truncated.
GROQ_MAX_TOKENS=

# -- OpenRouter ----------------------------------------------------------------

# Required on the default provider. One key for
# every model the coach may be compared on, open or frontier
# (docs/research/paid-llm-provider.md). A key out of credit is reported as a
# spent quota, with where to top it up. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# One model for every node, as https://openrouter.ai/models names it. Empty
# leaves each node on its measured choice; set, it moves all three off it,
# which is how a matrix row runs. Requests go only to hosts that honour every
# parameter sent, so the strict schema is enforced on the emission. A name
# OpenRouter does not route to is reported before the run starts.
OPENROUTER_MODEL=

# How hard each node's model reasons: none, low, medium or high. Empty is the
# measured choice's effort on the chosen model (none, high, low), and the
# model's own default on any other. Sent on OpenRouter only; a model whose
# listing takes no effort, or not that one, is reported before the run starts.
PLANNER_REASONING=
LOGGER_REASONING=
ENTRANCE_REASONING=

# The one host each node's requests may go to, by its slug, with no fallback.
# Empty is the chosen model's measured host (anthropic, parasail, cerebras),
# and OpenRouter's own routing on any other model. OPENROUTER_PROVIDER pins
# every node at once; a node's own line wins over it. The run record names
# the host that answered either way.
PLANNER_HOST=
LOGGER_HOST=
ENTRANCE_HOST=
OPENROUTER_PROVIDER=

# -- Telegram ------------------------------------------------------------------

# The bot's token, from @BotFather: send it /newbot and it answers with one.
# `trainer bot` stops without it, naming this file.
TELEGRAM_BOT_TOKEN=

# The only user id the bot answers. Anything arriving from anyone else is
# ignored. @userinfobot replies with yours.
TELEGRAM_OWNER_ID=

# The rest of what trainer reads is neither a credential nor a model setting.
# TRAINER_HOME is the directory everything this machine writes lives in --
# the training database, the checkpointer, training.toml, the eval records and
# the bot's rotated log
# -- and it defaults to ~/.reps, so replacing the laptop is one directory to
# copy. TRAINER_DB, TRAINER_CONFIG, TRAINER_CHECKPOINTS and TRAINER_EVAL_RUNS
# move one of those out of it, and TRAINER_GRAPH, TRAINER_REFERENCE_SET,
# TRAINER_RESIDUE and TRAINER_SNAPSHOT point at files in the repository. All
# have working defaults, and a fresh clone runs with none of them set.
