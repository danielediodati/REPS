# Copy to .env and fill in. `.env` is gitignored and is read by the `trainer`
# command only -- the test suite never loads it, because conftest.py takes
# credentials away from every test on purpose and a file that put them back
# would turn that guarantee into a guarantee about this machine.
#
# Everything here is optional on Ollama, and a missing value is reported as a
# state with the way out rather than as a failure of the plan you asked for.

# Which provider the coach talks to: ollama or groq. Defaults to ollama, which
# runs on this machine and costs nothing. Any other value is refused by name
# rather than quietly falling through to a provider you did not ask for.
LLM_BACKEND=

# -- Ollama --------------------------------------------------------------------

# The local model. Defaults to gpt-oss:20b, which has to be pulled before it
# can plan: `ollama pull gpt-oss:20b`. On the dev laptop it reads 52 tok/s and
# writes 10.3 tok/s, which is about four minutes for one plan and eleven when
# the validator refuses twice.
#
# Those are CPU numbers, and on that machine they are the only numbers there
# are: gpt-oss:20b terminates the Radeon 860M's Vulkan backend at any offload,
# four layers and 2.4 GB included, while llama3.1 runs on the same device. It
# is the model's MXFP4 quantisation against that driver, not memory. Set
# OLLAMA_IGPU_ENABLE=0 in the environment the Ollama *server* starts in, or
# every load fails with `llama-server process has terminated`. That variable
# belongs to Ollama and not to this file, which is why it is documented here
# and not set here.
OLLAMA_MODEL=

# How much of the model's context window to declare, in tokens. `trainer plan`
# falls back to the server's own setting; `trainer bot` refuses to start without
# at least 8192, the length session 6 measured at -- below it the admissible set
# is truncated and plans are refused for no visible reason. Measured: at 8192 a
# brief carrying half the catalog as stated preferences made the model emit a
# tool call its own server could not parse back. 16384 is what the dev laptop
# runs, and a 12 GB model plus a 16k context is at the edge of 32 GB in use.
OLLAMA_CONTEXT_LENGTH=

# Where the Ollama server is. Defaults to the local one on port 11434.
OLLAMA_BASE_URL=

# -- Groq ----------------------------------------------------------------------

# Required when LLM_BACKEND=groq, and also for `trainer log` and
# `trainer eval --suite log`, which stay on Groq until session 8 whatever
# LLM_BACKEND names. https://console.groq.com/keys
GROQ_API_KEY=

# The Groq model. Defaults to qwen/qwen3.8-27b, which is the Qwen whose
# structured output runs in *strict* mode -- constrained decoding, so the
# emitted plan conforms to the schema by construction rather than by luck. Both
# Qwen models on Groq are preview: they may be discontinued at short notice.
# When that happens, use openai/gpt-oss-120b, which is strict as well. Strict is
# not a preference: without it the enum of today's admissible ids is a
# suggestion, and an invented exercise id becomes possible again.
GROQ_MODEL=

# How much the model may write in one turn, reasoning included. Defaults to
# 1000, which is the free tier's ceiling on output tokens per minute -- declare
# more than the tier allows and the request is refused before any of it runs.
# Raise it on a paid tier: it is the first number to reach for when a plan
# comes back truncated.
GROQ_MAX_TOKENS=

# -- Telegram ------------------------------------------------------------------

# The bot's token, from @BotFather: send it /newbot and it answers with one.
# `trainer bot` stops without it, naming this file.
TELEGRAM_BOT_TOKEN=

# The only user id the bot answers. Anything arriving from anyone else is
# ignored. @userinfobot replies with yours.
TELEGRAM_OWNER_ID=

# The rest of what trainer reads is neither a credential nor a model setting:
# TRAINER_DB, TRAINER_CONFIG, TRAINER_CHECKPOINTS, TRAINER_GRAPH,
# TRAINER_REFERENCE_SET, TRAINER_RESIDUE and TRAINER_SNAPSHOT all point at
# files, all have working defaults, and a fresh clone runs with none of them set.
