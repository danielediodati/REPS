# Copy to .env and fill in. All variables are optional; see src/bellman/config/settings.py for defaults.

# LLM backend: "groq" (default, free tier, zero local setup) or "ollama" (fully local)
LLM_BACKEND=
GROQ_MODEL=
GROQ_API_KEY=

OLLAMA_HOST=
OLLAMA_MODEL=

# RAG layer -- CHROMA_PATH is rebuildable and
# defaults to data/vector_store (gitignored); CURATED_DIR defaults to data/curated, the
# committed hand-written corpus that ingestion reads. Both left unset on purpose: a fresh
# clone must work with one command, not with two absolute paths.
EMBEDDING_MODEL=
