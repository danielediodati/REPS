# Copy to .env and fill in. `.env` is gitignored and is read by the `trainer`
# command only -- the test suite never loads it, because conftest.py takes
# credentials away from every test on purpose and a file that put them back
# would turn that guarantee into a guarantee about this machine.
#
# The defaults need OPENROUTER_API_KEY and, for `trainer bot`, the two Telegram
# lines; everything else is optional. A missing value is reported as a state
# with the way out rather than as a failure of the plan you asked for.

# -- OpenRouter ----------------------------------------------------------------

# Required. One key for every model the coach may be compared on, open or
# frontier (docs/research/paid-llm-provider.md). A key out of credit is
# reported as a spent quota, with where to top it up.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Each node's own model, as https://openrouter.ai/models names it. Empty is
# the node's measured choice (docs/adr/0011): anthropic/claude-haiku-4.5
# plans, deepseek/deepseek-v4-flash logs, interviews and talks (the entrance),
# openai/gpt-6-luna directs between mesocycles. Each is checked before a run
# or the bot starts; a name OpenRouter does not route to is reported then.
PLANNER_MODEL=
LOGGER_MODEL=
ONBOARDING_MODEL=
SUPERVISOR_MODEL=
ENTRANCE_MODEL=

# One model for every node that names none of its own. Empty leaves each on
# its measured choice; set, it moves them all off it, which is how a matrix
# row runs. Requests go only to hosts that honour every parameter sent, so the
# strict schema is enforced on the emission.
OPENROUTER_MODEL=

# How hard each node's model reasons: none, low, medium or high. Empty is the
# measured choice's effort on the chosen model, and the model's own default on
# any other. A model whose listing takes no effort, or not that one, is
# reported before the run starts.
PLANNER_REASONING=
LOGGER_REASONING=
ONBOARDING_REASONING=
SUPERVISOR_REASONING=
ENTRANCE_REASONING=

# The one host each node's requests may go to, by its slug, with no fallback.
# Empty is the chosen model's measured host, and OpenRouter's own routing on
# any other model. OPENROUTER_PROVIDER pins every node at once; a node's own
# line wins over it. The run record names the host that answered either way.
PLANNER_HOST=
LOGGER_HOST=
ONBOARDING_HOST=
SUPERVISOR_HOST=
ENTRANCE_HOST=
OPENROUTER_PROVIDER=

# -- Telegram ------------------------------------------------------------------

# The bot's token, from @BotFather: send it /newbot and it answers with one.
# `trainer bot` stops without it, naming this file.
TELEGRAM_BOT_TOKEN=

# The only user id the bot answers. Anything arriving from anyone else is
# ignored. @userinfobot replies with yours.
TELEGRAM_OWNER_ID=

# The rest of what trainer reads is neither a credential nor a model setting.
# TRAINER_HOME is the directory everything this machine writes lives in --
# the training database (your declarations included), the checkpointer, the eval records and
# the bot's rotated log
# -- and it defaults to ~/.reps, so replacing the laptop is one directory to
# copy. TRAINER_DB, TRAINER_CHECKPOINTS and TRAINER_EVAL_RUNS
# move one of those out of it, and TRAINER_GRAPH, TRAINER_REFERENCE_SET,
# TRAINER_RESIDUE and TRAINER_SNAPSHOT point at files in the repository. All
# have working defaults, and a fresh clone runs with none of them set.
