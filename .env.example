# Copy to .env and fill in. `.env` is gitignored and is read by the `trainer`
# command only -- the test suite never loads it, because conftest.py takes
# credentials away from every test on purpose and a file that put them back
# would turn that guarantee into a guarantee about this machine.
#
# Everything here is optional except GROQ_API_KEY, and every missing value is
# reported as a state with the way out rather than as a failure of the plan
# you asked for.

# Which provider the agent talks to. Only "groq" is built; "ollama" is the
# one to come, and is refused by name rather than quietly falling through to
# Groq with your key. Defaults to groq.
LLM_BACKEND=

# The Groq model. Defaults to qwen/qwen3.8-27b, which is the Qwen whose
# structured output runs in *strict* mode -- constrained decoding, so the
# emitted plan conforms to the schema by construction rather than by luck. A
# plan that comes back malformed is a whole run thrown away, and the loop has
# no way to ask again. Both Qwen models on Groq are preview: they may be
# discontinued at short notice.
GROQ_MODEL=

# Required. https://console.groq.com/keys
GROQ_API_KEY=

# How much the model may write in one turn, reasoning included. Defaults to
# 1000, which is the free tier's ceiling on output tokens per minute -- declare
# more than the tier allows and the request is refused before any of it runs.
# Raise it on a paid tier: it is the first number to reach for when a plan
# comes back truncated.
GROQ_MAX_TOKENS=

# The rest of what trainer reads is neither a credential nor a model setting:
# TRAINER_DB, TRAINER_CONFIG, TRAINER_GRAPH, TRAINER_REFERENCE_SET,
# TRAINER_RESIDUE and TRAINER_SNAPSHOT all point at files, all have working
# defaults, and a fresh clone runs with none of them set.
